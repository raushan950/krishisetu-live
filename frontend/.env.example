# KrishiSetu Frontend API URL Configuration
# Vite inlines this value at BUILD time. Changing it on Vercel requires a Redeploy.
#
# Local development (optional; axios already defaults to local Django):
# VITE_API_URL=http://127.0.0.1:8000/api/v1
#
# Production (Vercel Project Settings > Environment Variables > Production):
VITE_API_URL=https://krishisetu-api-70rj.onrender.com/api/v1
